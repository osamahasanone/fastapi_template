[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = []

[tool.ruff.lint]
select = [
    "E",     # pycodestyle errors
    "W",     # pycodestyle warnings
    "F",     # Pyflakes
    "UP",    # pyupgrade
    "B",     # flake8-bugbear
    "SIM",   # flake8-simplify
    "I",     # isort
    "A",     # flake8-builtins
    "RUF",   # Ruff-specific rules
    "PL",    # Pylint
    "ASYNC", # flake8-async
    "FAST",  # FastAPI
]
fixable = ["ALL"]
unfixable = []

[tool.ruff.lint.flake8-bugbear]
# FastAPI declares dependencies as default values, e.g. x: str = Query(...)
extend-immutable-calls = ["fastapi.Depends", "fastapi.Query", "fastapi.Path", "fastapi.Body"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["PLR2004"]  # status codes like 200 in assertions

[tool.pytest]
pythonpath = ["."]
testpaths = ["tests"]
asyncio_mode = "auto"
# One event loop for the whole run, so pooled DB connections stay on the same loop.
asyncio_default_fixture_loop_scope = "session"
asyncio_default_test_loop_scope = "session"
